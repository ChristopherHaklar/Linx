DISCORD_TOKEN=your-bot-token-here

# Defaults for each server; people with Manage Server can change them with /server settings.

# Rewrite x.com / twitter.com links to fixvx.com
FIX_X_LINKS=true

# Rewrite Instagram post and reel links to an embed-fixer site (Discord shows no embed for instagram.com)
FIX_INSTAGRAM_LINKS=true
# The embed-fixer site. These sites often shut down. Change this when Instagram embeds stop working.
INSTAGRAM_FIX_HOST=vxinstagram.com

# Follow short links (amzn.to, vm.tiktok.com, reddit /s/ links, ...) so their real link can be cleaned.
# false turns this off everywhere, whatever servers choose.
EXPAND_SHORT_LINKS=true

# Hide embeds on the original message after replying (bot needs Manage Messages)
SUPPRESS_ORIGINAL_EMBEDS=true
